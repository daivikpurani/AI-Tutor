# AI Tutor Environment Configuration
# Copy this file to .env and update the values. Do not commit .env.

# OpenAI Configuration
OPENAI_API_KEY=

# Temporary: send every chat request directly to OpenAI and stream (no RAG, no hybrid routing)
# DIRECT_OPENAI_STREAMING=false

# Ollama Configuration (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.3:latest

# Server Configuration
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
VECTOR_DB_COLLECTION_NAME=ai_tutor_documents

# Document Processing
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
MAX_FILE_SIZE=10485760

# Vector Search Configuration
SIMILARITY_THRESHOLD=2.0
MAX_CONTEXT_CHUNKS=5

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_CHAT=60/minute
RATE_LIMIT_UPLOAD=10/minute
# Reject chat requests when prompt-injection patterns are detected (e.g. "ignore previous instructions")
REJECT_ON_INJECTION=false

# Logging
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
