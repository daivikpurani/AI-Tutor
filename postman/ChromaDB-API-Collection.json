		{
			"name": "Document Upload",
			"item": [
				{
					"name": "Upload Document File (Single or Multiple)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": [],
									"description": "For single file: Use 'file' field. For multiple files: Use 'files' field (see Upload Multiple Files request). Select a PDF, DOCX, TXT, or MD file to upload. The file will be chunked and stored in ChromaDB."
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/upload",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"upload"
							]
						},
						"description": "Unified upload endpoint that accepts both single and multiple files.\n\n- Single file: Use field name 'file' (backward compatible). Returns UploadResponse.\n- Multiple files: Use field name 'files' (see separate request below). Returns MultipleUploadResponse with per-file results.\n\nThe document(s) will be automatically chunked and embedded for vector search. Individual file failures don't stop the entire batch when uploading multiple files."
					},
					"response": [
						{
							"name": "Single File Success Response",
							"originalRequest": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "formdata",
									"formdata": [
										{
											"key": "file",
											"type": "file",
											"src": "sample_document.pdf"
										}
									]
								},
								"url": {
									"raw": "{{base_url}}/api/upload",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"upload"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "content-type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\n  \"message\": \"Successfully processed sample_document.pdf\",\n  \"filename\": \"sample_document.pdf\",\n  \"chunks_created\": 15,\n  \"status\": \"success\"\n}"
						}
					]
				},
				{
					"name": "Upload Multiple Files",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "files",
									"type": "file",
									"src": [],
									"description": "First file to upload (PDF, DOCX, TXT, or MD)"
								},
								{
									"key": "files",
									"type": "file",
									"src": [],
									"description": "Second file to upload (add more 'files' entries for additional files)"
								},
								{
									"key": "files",
									"type": "file",
									"src": [],
									"description": "Third file to upload (optional - add/remove as needed)"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/upload",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"upload"
							]
						},
						"description": "Upload multiple documents in a single request. Use field name 'files' (plural) and add multiple file entries with the same field name.\n\nAll files will be processed sequentially. Individual file failures don't stop the entire batch. Returns detailed per-file results including success/error status for each file."
					},
					"response": [
						{
							"name": "Multiple Files Success Response",
							"originalRequest": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "formdata",
									"formdata": [
										{
											"key": "files",
											"type": "file",
											"src": "document1.pdf"
										},
										{
											"key": "files",
											"type": "file",
											"src": "document2.pdf"
										},
										{
											"key": "files",
											"type": "file",
											"src": "document3.pdf"
										}
									]
								},
								"url": {
									"raw": "{{base_url}}/api/upload",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"upload"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "content-type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\n  \"message\": \"Processed 3 files: 2 successful, 1 failed\",\n  \"total_files\": 3,\n  \"successful\": 2,\n  \"failed\": 1,\n  \"results\": [\n    {\n      \"filename\": \"document1.pdf\",\n      \"chunks_created\": 45,\n      \"status\": \"success\",\n      \"error\": null\n    },\n    {\n      \"filename\": \"document2.pdf\",\n      \"chunks_created\": 32,\n      \"status\": \"success\",\n      \"error\": null\n    },\n    {\n      \"filename\": \"document3.pdf\",\n      \"chunks_created\": 0,\n      \"status\": \"error\",\n      \"error\": \"Unsupported file format\"\n    }\n  ],\n  \"timestamp\": \"2024-01-01T12:00:00.000Z\"\n}"
