# Ai-Tutor Environment Configuration
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# API KEYS
# =============================================================================

# OpenAI API Key for GPT models
OPENAI_API_KEY=your_openai_api_key_here

# ChaiJibri API Key (alternative LLM provider)
CHAIBRI_API_KEY=your_chaibri_api_key_here

# Ollama Configuration (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama2

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ai-tutor

# PostgreSQL connection string (alternative)
DATABASE_URL=postgresql://username:password@localhost:5432/ai_tutor

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port
PORT=3001

# Node environment
NODE_ENV=development

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Backend API URL for frontend
REACT_APP_API_URL=http://localhost:8000

# Frontend port
REACT_APP_PORT=3000

# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================
# Using ChromaDB (persistent local store) for vector storage in backend_python
# No external API key required

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# Default LLM model
DEFAULT_LLM_MODEL=gpt-3.5-turbo

# Maximum tokens for responses
MAX_TOKENS=1000

# Temperature for response generation (0.0 to 1.0)
LLM_TEMPERATURE=0.7

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum file size (in bytes)
MAX_FILE_SIZE=10485760

# Allowed file types
ALLOWED_FILE_TYPES=.pdf,.docx,.doc,.txt,.md

# Upload directory
UPLOAD_DIR=./uploads

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT secret key
JWT_SECRET=your_jwt_secret_key_here

# Session secret
SESSION_SECRET=your_session_secret_here

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file path
LOG_FILE_PATH=./logs/ai-tutor.log

# =============================================================================
# HOMEWORK GRADING SUBSYSTEM (homework-grader)
# These variables are read by the grading subsystem mounted at /grading.
# They are loaded from homework-grader/.env automatically; you only need to
# set them here if you want to override the defaults or run without that file.
# =============================================================================

# Google Gemini API key — required for AI grading and embeddings
# Get yours at: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (gemini-1.5-pro, gemini-2.5-flash-lite, etc.)
# GEMINI_MODEL=gemini-2.5-flash-lite

# PostgreSQL connection string for the grading database
# The database must be created before starting: createdb homework_grading_system
# DATABASE_URL=postgresql://username:password@localhost:5432/homework_grading_system

# ChromaDB storage path for grading vector store (relative to homework-grader/)
# CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# File upload directories (relative to homework-grader/)
# MATERIALS_UPLOAD_DIR=./data/uploads/materials
# SUBMISSIONS_UPLOAD_DIR=./data/uploads/submissions
